@page "/admin/projects"
@attribute [Authorize(Roles = "Admin")]
@inject ProjectDataAccess projectData
@inject ProjectBoardDataAccess boardData
@inject ProjectTaskDataAccess taskData
@inject AppTimeZone appTimeZone
@inject Statuses state
@inject IToastService ToastService
@inject IJSRuntime JS

<PageTitle>Admin - Projects</PageTitle>
<h5>Projects</h5>
<br />
<FluentButton Appearance="Appearance.Accent" OnClick="Create">Create</FluentButton>
<br />
<br />
@if (projectItems != null)
{
    @foreach (var p in projectItems)
    {
    <FluentCard Height="auto">
        <h4>@p.Title</h4>
        <FluentToolbar style="width:100%">
            <h5>Start: @p.StartDate - End: @p.EndDate</h5>
            <StatusBadge statusIndex="@p.Status" />
            <FluentButton Color="Color.Success" OnClick="e => Update(e, p.Id)" IconEnd="@(FontAwesome.Icon("fas fa-file-pen"))" slot="end"></FluentButton>
            <FluentButton Color="Color.Error" OnClick="e => Delete(e, p)" IconEnd="@(FontAwesome.Icon("fas fa-trash"))" slot="end"></FluentButton>
        </FluentToolbar>
        <br />
        <hr />
        @((MarkupString)MarkdownService.Parse(p.Description))
        <br />
        @if (p.Boards.Count > 0)
        {
            <br />
                <FluentToolbar style="width:100%">
                    <FluentButton Appearance="Appearance.Accent" OnClick="e => CreateBoard(e, p.Id)" IconEnd="@(FontAwesome.Icon("fas fa-plus"))" slot="end"></FluentButton>
                </FluentToolbar>
            <FluentGrid Spacing="2">
                @foreach (var board in p.Boards)
                {
                    <FluentGridItem xs="12" sm="6" md="4">
                        <FluentCard Height="auto" Class="kanban-board">
                            <FluentToolbar style="width:100%">
                                <div role="status" style="height: 100%; vertical-align: middle; padding: 10px 10px 0px 10px; border: 2px solid gray; border-radius: 5px; color: @board.Color; background-color: @board.BackgroundColor;" slot="start">
                                    <h5><i class="@board.Icon" />&nbsp;&nbsp;@board.Title</h5>
                                </div>
                                <FluentButton Appearance="Appearance.Accent" OnClick="e => CreateTask(e, p.Id, board.Id)" IconEnd="@(FontAwesome.Icon("fas fa-plus"))" ></FluentButton>
                                <FluentButton OnClick="e => UpdateBoard(e, board.Id)" IconEnd="@(FontAwesome.Icon("fas fa-file-pen"))" slot="end"></FluentButton>
                                <FluentButton Color="Color.Error" OnClick="e => DeleteBoard(e, board)" IconEnd="@(FontAwesome.Icon("fas fa-trash"))" slot="end"></FluentButton>
                            </FluentToolbar>
                            <hr />
                            <div class="kanban-dropzone">
                                @if (board.Tasks.Count == 0)
                                {
                                    <div class="kanban-empty-hint">Drop tasks here</div>
                                }
                                <FluentSortableList TItem="ProjectTaskModel"
                                                    Id="@BoardListDomId(board.Id)"
                                                    Group="@($"project-{p.Id}")"
                                                    Items="@board.Tasks"
                                                    Handle="true"
                                                    Fallback="true"
                                                    OnUpdate="@(args => OnTaskReorderAsync(args, board))"
                                                    OnRemove="@(args => OnTaskMoveAsync(args, p, board))"
                                                    ListBorderWidth="0"
                                                    ListBorderColor="transparent"
                                                    ListItemBorderWidth="0"
                                                    ListItemBackgroundColor="transparent"
                                                    ListItemPadding="0"
                                                    ListPadding="0"
                                                    ListItemSpacing="4px"
                                                    ListItemHeight="auto"
                                                    Style="min-height: 140px;">
                                    <ItemTemplate>
                                        <div class="sortable-item-content" style="width: 100%;">
                                            <FluentCard>
                                                <FluentToolbar style="width:100%">
                                                    <h5>@context.Title</h5>
                                                    <FluentButton OnClick="e => UpdateTask(e, context.Id)"
                                                                  IconEnd="@(FontAwesome.Icon("fas fa-file-pen"))"
                                                                  slot="end"></FluentButton>
                                                    <FluentButton Color="Color.Error"
                                                                  OnClick="e => DeleteTask(e, context)"
                                                                  IconEnd="@(FontAwesome.Icon("fas fa-trash"))"
                                                                  slot="end"></FluentButton>
                                                    <div class="sortable-grab" slot="end" title="Drag task">
                                                        <FluentButton IconEnd="@(FontAwesome.Icon("fas fa-dolly"))"
                                                                      AriaLabel="Drag task"></FluentButton>
                                                    </div>
                                                </FluentToolbar>
                                                @if (!string.IsNullOrWhiteSpace(context.Description))
                                                {
                                                    <hr />
                                                    @((MarkupString)MarkdownService.Parse(context.Description))
                                                }
                                            </FluentCard>
                                        </div>
                                    </ItemTemplate>
                                </FluentSortableList>
                            </div>
                        </FluentCard>
                    </FluentGridItem>
                }
            </FluentGrid>
        }
        else
        {
            <FluentButton Color="Color.Error" OnClick="e => InitBoards(p.Id)">Initialize Board</FluentButton>
        }
    </FluentCard>
    <br />
    }
}

@code {
    [Inject] private IDialogService DialogService { get; set; } = default!;
    private List<ProjectModel>? projectItems { get; set; }
    private string? _highlightedContentKey;
    private readonly SemaphoreSlim _persistLock = new(1, 1);

    protected override async Task OnInitializedAsync()
    {
        await RefreshData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _highlightedContentKey = projectItems?.Count.ToString();
            await JS.InvokeVoidAsync("highlightCode");
        }
    }

    private static string BoardListDomId(string boardId) => $"board-{boardId}";

    private static string? ParseBoardId(string? listDomId)
    {
        if (string.IsNullOrWhiteSpace(listDomId))
        {
            return null;
        }

        const string prefix = "board-";
        return listDomId.StartsWith(prefix, StringComparison.Ordinal)
            ? listDomId[prefix.Length..]
            : listDomId;
    }

    private async Task RefreshData()
    {
        var projects = await projectData.GetAllAdminWithTasks();
        projectItems = projects.ToList();
        foreach (var project in projectItems)
        {
            project.Boards ??= [];
            foreach (var board in project.Boards)
            {
                board.Tasks ??= [];
            }
        }
    }

    private async Task OnTaskReorderAsync(FluentSortableListEventArgs args, ProjectBoardModel board)
    {
        if (args is null || args.OldIndex == args.NewIndex)
        {
            return;
        }

        // Ignore overlapping drags while a save is in flight (prevents list thrash).
        if (!await _persistLock.WaitAsync(0))
        {
            ToastService.ShowWarning("Still saving the previous move — try again in a moment.");
            return;
        }

        try
        {
            if (args.OldIndex < 0 || args.OldIndex >= board.Tasks.Count)
            {
                return;
            }

            var item = board.Tasks[args.OldIndex];
            board.Tasks.RemoveAt(args.OldIndex);
            InsertAt(board.Tasks, args.NewIndex, item);

            await PersistBoardsCoreAsync([board], $"Saved order for '{item.Title}'.");
        }
        finally
        {
            _persistLock.Release();
        }
    }

    private async Task OnTaskMoveAsync(FluentSortableListEventArgs args, ProjectModel project, ProjectBoardModel fromBoard)
    {
        if (args is null)
        {
            return;
        }

        if (!await _persistLock.WaitAsync(0))
        {
            ToastService.ShowWarning("Still saving the previous move — try again in a moment.");
            return;
        }

        try
        {
            if (args.OldIndex < 0 || args.OldIndex >= fromBoard.Tasks.Count)
            {
                return;
            }

            var toBoardId = ParseBoardId(args.ToListId);
            var toBoard = project.Boards.FirstOrDefault(b => b.Id == toBoardId);
            if (toBoard is null || toBoard.Id == fromBoard.Id)
            {
                ToastService.ShowError("Could not determine the target board for that move.");
                await RefreshData();
                return;
            }

            var item = fromBoard.Tasks[args.OldIndex];
            fromBoard.Tasks.RemoveAt(args.OldIndex);
            item.BoardId = toBoard.Id;
            InsertAt(toBoard.Tasks, args.NewIndex, item);

            await PersistBoardsCoreAsync(
                [fromBoard, toBoard],
                $"Moved '{item.Title}' to '{toBoard.Title}'.");
        }
        finally
        {
            _persistLock.Release();
        }
    }

    private static void InsertAt(List<ProjectTaskModel> tasks, int index, ProjectTaskModel item)
    {
        if (index < 0 || index >= tasks.Count)
        {
            tasks.Add(item);
        }
        else
        {
            tasks.Insert(index, item);
        }
    }

    private async Task PersistBoardsCoreAsync(IEnumerable<ProjectBoardModel> boards, string successMessage)
    {
        try
        {
            foreach (var board in boards)
            {
                for (var i = 0; i < board.Tasks.Count; i++)
                {
                    var task = board.Tasks[i];
                    var order = i + 1;
                    if (task.Order == order && task.BoardId == board.Id)
                    {
                        continue;
                    }

                    task.Order = order;
                    task.BoardId = board.Id;
                    await taskData.Update(task);
                }
            }

            ToastService.ShowSuccess(successMessage);
        }
        catch (Exception)
        {
            ToastService.ShowError("Failed to save task changes. Reloading boards.");
            await RefreshData();
        }
    }

    private async Task InitBoards(string projectId)
    {
        try
        {
            await boardData.InitBoards(projectId);
            await RefreshData();
        }
        catch (Exception)
        {
            ToastService.ShowError("Failed to initialize boards.");
        }
    }

    private async Task Delete(MouseEventArgs e, ProjectModel project)
    {
        DeleteDialogModel item = new() { Id = project.Id, Name = project.Title };
        var parameters = new DialogParameters()
        {
            Height = "auto",
            Width = "auto",
            Title = "Delete Project",
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
        };

        var dialog = await DialogService.ShowDialogAsync<DeleteDialog>(item, parameters);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            try
            {
                await projectData.Delete(project.Id);
                ToastService.ShowSuccess("Project Deleted.");
                await RefreshData();
            }
            catch (Exception)
            {
                ToastService.ShowError("Failed to delete project.");
            }
        }
    }

    private async Task Create()
    {
        ProjectModel model = new()
        {
            StartDate = appTimeZone.Today(),
            EndDate = appTimeZone.Today().AddDays(14)
        };
        var parameters = new DialogParameters()
        {
            Height = "auto",
            Width = "auto",
            Title = "Create Project",
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
        };

        var dialog = await DialogService.ShowDialogAsync<ProjectDialog>(model, parameters);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            ToastService.ShowSuccess("Project Created.");
            await RefreshData();
        }
    }

    private async Task Update(MouseEventArgs e, string id)
    {
        var model = await projectData.GetId(id);
        if (model is null)
        {
            ToastService.ShowError("Project not found.");
            return;
        }

        var parameters = new DialogParameters()
        {
            Height = "auto",
            Width = "auto",
            Title = "Update Project",
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
        };

        var dialog = await DialogService.ShowDialogAsync<ProjectDialog>(model, parameters);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            ToastService.ShowSuccess("Project Updated.");
            await RefreshData();
        }
    }

    private async Task DeleteTask(MouseEventArgs e, ProjectTaskModel projectTaskItem)
    {
        DeleteDialogModel item = new() { Id = projectTaskItem.Id, Name = projectTaskItem.Title };
        var parameters = new DialogParameters()
        {
            Height = "auto",
            Width = "auto",
            Title = "Delete Project Task",
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
        };

        var dialog = await DialogService.ShowDialogAsync<DeleteDialog>(item, parameters);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            try
            {
                await taskData.Delete(projectTaskItem.Id);
                ToastService.ShowSuccess("Project Task Deleted.");
                await RefreshData();
            }
            catch (Exception)
            {
                ToastService.ShowError("Failed to delete task.");
            }
        }
    }

    private async Task CreateTask(MouseEventArgs e, string projectId, string boardId)
    {
        ProjectTaskModel model = new()
        {
            BoardId = boardId,
            ProjectId = projectId
        };
        var parameters = new DialogParameters()
        {
            Height = "auto",
            Width = "auto",
            Title = "Create Project Task",
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
        };

        var dialog = await DialogService.ShowDialogAsync<ProjectTaskDialog>(model, parameters);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            ToastService.ShowSuccess("Project Task Created.");
            await RefreshData();
        }
    }

    private async Task UpdateTask(MouseEventArgs e, string id)
    {
        var model = await taskData.GetId(id);
        if (model is null)
        {
            ToastService.ShowError("Task not found.");
            return;
        }

        var parameters = new DialogParameters()
        {
            Height = "auto",
            Width = "auto",
            Title = "Update Project Task",
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
        };

        var dialog = await DialogService.ShowDialogAsync<ProjectTaskDialog>(model, parameters);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            ToastService.ShowSuccess("Project Task Updated.");
            await RefreshData();
        }
    }

    private async Task DeleteBoard(MouseEventArgs e, ProjectBoardModel projectBoardItem)
    {
        DeleteDialogModel item = new() { Id = projectBoardItem.Id, Name = projectBoardItem.Title };
        var parameters = new DialogParameters()
        {
            Height = "auto",
            Width = "auto",
            Title = "Delete Project Board",
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
        };

        var dialog = await DialogService.ShowDialogAsync<DeleteDialog>(item, parameters);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            try
            {
                await boardData.Delete(projectBoardItem.Id);
                ToastService.ShowSuccess("Project Board Deleted.");
                await RefreshData();
            }
            catch (Exception)
            {
                ToastService.ShowError("Failed to delete board.");
            }
        }
    }

    private async Task CreateBoard(MouseEventArgs e, string projectId)
    {
        ProjectBoardModel model = new() { ProjectId = projectId };
        var parameters = new DialogParameters()
        {
            Height = "auto",
            Width = "auto",
            Title = "Create Project Board",
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
        };

        var dialog = await DialogService.ShowDialogAsync<ProjectBoardDialog>(model, parameters);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            ToastService.ShowSuccess("Project Board Created.");
            await RefreshData();
        }
    }

    private async Task UpdateBoard(MouseEventArgs e, string id)
    {
        var model = await boardData.GetId(id);
        if (model is null)
        {
            ToastService.ShowError("Board not found.");
            return;
        }

        var parameters = new DialogParameters()
        {
            Height = "auto",
            Width = "auto",
            Title = "Update Project Board",
            PreventDismissOnOverlayClick = true,
            PreventScroll = true,
        };

        var dialog = await DialogService.ShowDialogAsync<ProjectBoardDialog>(model, parameters);
        var result = await dialog.Result;

        if (!result.Cancelled)
        {
            ToastService.ShowSuccess("Project Board Updated.");
            await RefreshData();
        }
    }
}
