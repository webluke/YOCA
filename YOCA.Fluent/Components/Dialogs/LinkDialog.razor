@inject LinkDataAccess dataAccess
@inject LinkTargets targets
@inject IToastService ToastService
@implements IDialogContentComponent<LinkModel>

<!-- Header -->
<FluentDialogHeader ShowDismiss="true">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <FluentIcon Value="@(FontAwesome.Icon("fas fa-link"))" />
        <FluentLabel Typo="Typography.PaneHeader">
            @Dialog.Instance.Parameters.Title
        </FluentLabel>
    </FluentStack>
</FluentDialogHeader>

<!-- Body -->
<FluentDialogBody>
    <EditForm Model="@Content" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <FluentValidationSummary />
        <FluentStack Orientation="Orientation.Vertical">
            <FluentTextField @bind-Value="@Content.Title" Label="Title" style="width: 100%;" />
            <FluentTextField @bind-Value="@Content.MenuName" Label="Menu Name" style="width: 100%;" />
            <FluentTextField @bind-Value="@Content.Icon" Label="Icon" style="width: 100%;" />
            <FluentNumberField @bind-Value="@Content.Order" Label="Order" style="width: 100%;" />
            <InputSelect @bind-Value="@Content.Type">
                @foreach (var t in targets.DefaultLinkTargets)
                {
                    <option value=@t.Key>@t.Value.Name</option>
                }
            </InputSelect>
            <FluentSwitch @bind-Value="@Content.IsPublished" Label="Published" style="width: 100%;" />
            <FluentTextField @bind-Value="@Content.URL" Label="URL" style="width: 100%;" />
            <FluentLabel>Use a site path (e.g. /page/about) or an http(s) URL.</FluentLabel>
        </FluentStack>
        <button type="submit" hidden id="link-dialog-submit" disabled="@_saving"></button>
    </EditForm>
</FluentDialogBody>

<!-- Footer -->
<FluentDialogFooter>
    @if (string.IsNullOrEmpty(Content.Id))
    {
        <FluentButton Appearance="Appearance.Accent" OnClick="SubmitForm" Disabled="@_saving">Create</FluentButton>
    }
    else
    {
        <FluentButton Appearance="Appearance.Accent" OnClick="SubmitForm" Disabled="@_saving">Update</FluentButton>
    }
    <FluentButton Appearance="Appearance.Neutral" OnClick="@Cancel" Disabled="@_saving">Cancel</FluentButton>
</FluentDialogFooter>

@code {
    [CascadingParameter]
    public FluentDialog Dialog { get; set; } = default!;
    [Parameter]
    public LinkModel Content { get; set; } = default!;

    private bool _saving;

    private void Cancel() => Dialog.CancelAsync();

    private async Task SubmitForm()
    {
        // Trigger EditForm validation via OnValidSubmit by clicking the hidden submit.
        // Direct validate path for Fluent dialog footer buttons.
        if (!UrlValidation.IsAllowedLinkUrl(Content.URL))
        {
            ToastService.ShowError("URL must be a relative path starting with / or an http(s) URL.");
            return;
        }

        await SaveAsync();
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        if (!UrlValidation.IsAllowedLinkUrl(Content.URL))
        {
            ToastService.ShowError("URL must be a relative path starting with / or an http(s) URL.");
            return;
        }

        _saving = true;
        try
        {
            if (string.IsNullOrEmpty(Content.Id))
            {
                await dataAccess.Insert(Content);
            }
            else
            {
                await dataAccess.Update(Content);
            }

            await Dialog.CloseAsync();
        }
        catch (Exception)
        {
            ToastService.ShowError("Failed to save link.");
        }
        finally
        {
            _saving = false;
        }
    }
}
